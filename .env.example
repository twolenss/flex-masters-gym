# Copy to .env and replace the values before deployment.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://flexmaster:change-me@localhost:5432/flexmaster
# Use a generated 32+ character value in production.
SESSION_SECRET=replace-with-a-long-random-secret
# Comma-separated browser origins permitted to call the API.
ALLOWED_ORIGINS=http://localhost:5173
