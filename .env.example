# Copy to .env and replace the values before deployment.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://flexmaster:change-me@localhost:5432/flexmaster
# Use a generated 32+ character value in production.
SESSION_SECRET=replace-with-a-long-random-secret
# Initial administrator for a fresh database. Use a unique password in production.
ADMIN_EMAIL=admin@yourgym.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Comma-separated browser origins permitted to call the API.
ALLOWED_ORIGINS=http://localhost:5173
